# Variables del stack (en Portainer: Environment variables del stack)
# Secretos
TOKEN=
BRIDGE_API_KEY=
BRIDGE_PASSWORD=
AIRDCPP_PASS=
RADARR_API_KEY=
SONARR_API_KEY=
# URLs
PUBLIC_URL=https://airdcpp-stream.example.com
BRIDGE_MOVIES_URL=http://IP-DEL-SERVIDOR:8001
BRIDGE_SERIES_URL=http://IP-DEL-SERVIDOR:8002
AIRDCPP_URL=http://IP-DEL-SERVIDOR:54345
RADARR_URL=https://radarr.example.com
SONARR_URL=https://sonarr.example.com
# Carpetas del servidor (las mismas que usa AirDC++ y la raiz de Radarr/Sonarr)
DOWNLOADS_MOVIES_DIR=/ruta/descargas/peliculas
DOWNLOADS_SERIES_DIR=/ruta/descargas/series
LIBRARY_MOVIES_DIR=/ruta/biblioteca/peliculas
LIBRARY_SERIES_DIR=/ruta/biblioteca/series
